---
import Base from "../layouts/Base.astro";
---

<Base title="Verdwaald · D'n Heiten Haspel">
  <main class="hero" style="min-height: 100vh">
    <div aria-hidden="true" class="hero__layer hero__sun sun"></div>
    <div aria-hidden="true" class="hero__layer hero__blob blob"></div>
    <div class="hero__logo wob"><img class="iri" src="/logo.png" width="322" height="354" alt="D'n Heiten Haspel" /></div>
    <h1 class="groovy"><span class="melt">404</span></h1>
    <p class="hero__tag">Dees pagina besteit neet. Baetersjap!</p>
    <p style="position: relative; margin-top: 40px">
      <a class="pill--ink" href="/" style="padding: 14px 26px; border-radius: 999px; text-decoration: none; font-weight: 700">Truuk nao veiligheid</a>
    </p>
  </main>
</Base>
