---
import Base from "../layouts/Base.astro";
import gigs from "../data/gigs.json";
import videos from "../data/videos.json";
import sponsors from "../data/sponsors.json";

// Public site key. Falls back to Cloudflare's always-passes test key for local dev.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "1x00000000000000000000AA";

const slogans = ["Blief van mien beer", "Drink opfnie", "Ceci n'est pas un saxophone", "Alzelaeve kei gezellig"];
const feesOptions = ["Vastelaovend", "Bruiloft", "Verjaordaag", "Bedrijfsfees", "Kroeg", "Iets wat neet besteit"];
---

<Base>
  <nav class="nav" aria-label="Hoofdmenu">
    <a class="nav__home" href="#top">D'n Heiten Haspel</a>
    <ul class="nav__links">
      <li><a class="pill--ink" href="#wie">Wie?</a></li>
      <li><a class="pill--pink" href="#video">Video's</a></li>
      <li><a class="pill--orange" href="#gewaes">Gewaes</a></li>
      <li><a class="pill--violet" href="#boeke">Boeke</a></li>
      <li><a class="pill--white" href="#vrinde">Vrinde</a></li>
    </ul>
  </nav>

  <main>
    <!-- HERO -->
    <header id="top" class="hero">
      <div aria-hidden="true" class="hero__layer hero__sun sun"></div>
      <div aria-hidden="true" class="hero__layer hero__rings sunback"></div>
      <div aria-hidden="true" class="hero__layer hero__blob blob"></div>

      <div class="hero__logo wob">
        <img
          class="iri"
          src="/logo.png"
          width="322"
          height="354"
          alt="Logo van D'n Heiten Haspel: een kabelhaspel met stekker, sinds 2003"
          fetchpriority="high"
        />
      </div>
      <h1 class="groovy"><span class="melt">Joekskepèl</span></h1>
      <p class="hero__tag">Oet Venlo · sinds 2003 · net euver 't rendje</p>

      <div aria-hidden="true" class="sticker sticker--round float">Kei<br />gezellig!</div>
      <div aria-hidden="true" class="sticker sticker--eye float2">
        <svg viewBox="0 0 100 60" width="100%">
          <ellipse cx="50" cy="30" rx="48" ry="28" fill="#fff" stroke="#1a0033" stroke-width="4"></ellipse>
          <g class="blink">
            <circle cx="50" cy="30" r="17" fill="#ff3d9a" stroke="#1a0033" stroke-width="4"></circle>
            <circle cx="50" cy="30" r="7" fill="#1a0033"></circle>
            <circle cx="45" cy="25" r="3" fill="#fff"></circle>
          </g>
        </svg>
      </div>
      <p aria-hidden="true" class="sticker sticker--note float">Dees website is gemaak oonder invloed van 'n sousafoon.</p>
    </header>

    <!-- MARQUEE -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {[0, 1].map(() => slogans.map((s) => [<span>{s}</span>, <span class="marquee__star">✺</span>]))}
      </div>
    </div>

    <!-- WIE -->
    <section id="wie" class="section wie">
      <div class="wrap wie__row">
        <h2 class="groovy-l stroke"><span class="melt">Wie zien veer?</span></h2>
        <p>
          D'n Heiten Haspel is Venloos cultureel erfgoed. Net euver 't rendje, mer alzelaeve kei gezellig.
          [ZIN OVER DE BAND, EEN OF TWEE REGELS.]
        </p>
      </div>
    </section>

    <!-- VIDEO -->
    <section id="video" class="section video">
      <div aria-hidden="true" class="video__sun sun"></div>
      <div class="wrap" style="position: relative">
        <h2 class="groovy"><span class="melt">Kieke &amp; loestere</span></h2>
        <p class="lead">Vastelaovend in bewegend beeld. Neet geschik veur mense die zeekziek waere.</p>

        <ul class="video__grid" role="list" style="list-style: none; padding: 0">
          {
            videos.map((v) => {
              const still = v.still || (v.youtubeId ? `https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg` : "");
              return (
                <li>
                  {v.youtubeId ? (
                    <button type="button" class="vid tilt" data-youtube={v.youtubeId} data-title={v.titel}>
                      <div class="vid__frame blob">
                        <img class="hue" src={still} alt="" loading="lazy" />
                        <span class="vid__play">
                          <svg aria-hidden="true" viewBox="0 0 24 24" width="34" height="34">
                            <path d="M8 5v14l11-7z" fill="#1a0033" />
                          </svg>
                        </span>
                      </div>
                      <p class="vid__title">
                        <span class="sr-only">Speel af: </span>
                        {v.titel}
                      </p>
                    </button>
                  ) : (
                    <div class="vid vid--soon">
                      <div class="vid__frame blob">
                        {still && <img class="hue" src={still} alt="" loading="lazy" />}
                        <span class="vid__play">binnen&shy;kort</span>
                      </div>
                      <p class="vid__title">{v.titel}</p>
                    </div>
                  )}
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    <!-- GEWAES -->
    <section id="gewaes" class="section gewaes">
      <div class="wrap">
        <h2 class="groovy stroke"><span class="melt">Waor veer al gewaes zien</span></h2>
        <p class="lead">En waor veer neet meer welkom zien. [AANVULLEN]</p>
        <ul class="gigs">
          {
            gigs.map((g, i) => (
              <li class:list={["gig", i % 2 ? "float" : "float2"]}>
                {g.plaats} ’{g.jaor}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- BOEKE -->
    <section id="boeke" class="section boeke">
      <div aria-hidden="true" class="boeke__rings sunback"></div>
      <div class="wrap boeke__row">
        <div class="boeke__intro">
          <h2 class="groovy"><span class="melt">Boeke!</span></h2>
          <p class="lead">
            'n Fees, 'n optocht, 'n bruiloft of 'n kroeg die te stil is? Veer kómme blaoze. Of veer kómme te laat, mer veer
            kómme.
          </p>
          <p class="boeke__kicker">Of mail drek</p>
          <a class="boeke__mail" href="mailto:info@heitenhaspel.nl">info@heitenhaspel.nl</a>
        </div>

        <form id="boeke-form" class="form" method="post" action="/api/boeke">
          <label>Naam<input type="text" name="naam" autocomplete="name" required maxlength="120" /></label>
          <label>E-mail<input type="email" name="email" autocomplete="email" required maxlength="200" /></label>
          <label>Datum<input type="date" name="datum" /></label>
          <label>Plaats<input type="text" name="plaats" maxlength="160" /></label>
          <label class="full"
            >Wat veur fees?
            <select name="fees">
              {feesOptions.map((o) => <option>{o}</option>)}
            </select>
          </label>
          <label class="full"
            >Bericht (of gewoon dien lievelingskleur)
            <textarea name="bericht" rows="4" maxlength="5000"></textarea>
          </label>

          <label class="form__honey" aria-hidden="true"
            >Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label
          >

          <div class="full cf-turnstile" data-sitekey={turnstileSiteKey} data-language="nl"></div>

          <button type="submit" class="form__submit tilt">Verstuur de vibes</button>
          <p id="boeke-status" class="form__status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <!-- VRINDE + SPONSORS -->
    <section id="vrinde" class="section">
      <div class="wrap vrinde__row">
        <div class="vrinde__card blob">
          <h2 class="groovy-l stroke">Vrinde van</h2>
          <p>
            Wieës vrind van D'n Heiten Haspel veur minimaal <strong>€15 per jaor</strong>. Euvermake nao <strong
              >[IBAN]</strong
            > t.n.v. Joekskepèl D'n Heiten Haspel, mit dien naam, adres en e-mail.
          </p>
          <p class="small">Doorveur krieg se: eeuwige roem, 'n knik van de sousafoon en [AANVULLEN].</p>
        </div>

        <div class="sponsors">
          <h2>Sponsors</h2>
          <p>Hie kan dien logo smelte.</p>
          <ul class="sponsors__grid">
            {
              sponsors.map((s) => {
                const inner = s.logo ? <img src={s.logo} alt={s.naam} loading="lazy" /> : s.naam;
                return (
                  <li>
                    {s.url ? (
                      <a class="sponsor tilt" href={s.url} rel="noopener sponsored" target="_blank">
                        {inner}
                      </a>
                    ) : (
                      <div class="sponsor tilt">{inner}</div>
                    )}
                  </li>
                );
              })
            }
            <li><a class="sponsor sponsor--cta tilt" href="#boeke">Hie dien naam?</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__row">
      <div class="footer__brand">
        <img class="iri" src="/logo.png" width="322" height="354" alt="D'n Heiten Haspel" loading="lazy" />
        <p>© 2003–{new Date().getFullYear()} Joekskepèl D'n Heiten Haspel<br />Ceci n'est pas un footer.</p>
      </div>
      <ul class="socials">
        <li>
          <a class="tilt" href="https://www.instagram.com/dnheitenhaspel/" aria-label="Instagram" style="background: var(--pink)">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#1a0033" stroke-width="2.2" stroke-linecap="round">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="#1a0033"></circle>
            </svg>
          </a>
        </li>
        <li>
          <a class="tilt" href="https://www.facebook.com/heitenhaspel/" aria-label="Facebook" style="background: var(--acid)">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#1a0033" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V21M6 11h8"></path>
            </svg>
          </a>
        </li>
        <li>
          <a class="tilt" href="https://twitter.com/heitenhaspel/" aria-label="X / Twitter" style="background: var(--orange)">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#1a0033" stroke-width="2.4" stroke-linecap="round">
              <path d="M4 4l16 16M20 4L4 20"></path>
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </footer>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    import "../scripts/videos";
    import "../scripts/booking";
  </script>
</Base>
